# Explicit local demonstration. Never enable on a publicly reachable server.
# Start with pnpm dev (binds 127.0.0.1) and choose a demo identity explicitly.
PAGER_DEMO=false
PAGER_APP_URL=http://127.0.0.1:3000
# Demo only; defaults to .data/pager-demo, separate from every real database.
PAGER_DATA_DIR=
# Optional >=32 random characters. If omitted a local .data session.key is generated.
PAGER_DEMO_SESSION_SECRET=

# Real integration mode: PAGER_DEMO=false. Apply supabase/migrations with Supabase CLI.
# Setup, migration history and hosted OTP templates: supabase/README.md.
# Use a server-only database owner / BYPASSRLS connection; browser roles cannot write.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never use a NEXT_PUBLIC_ prefix for this key.
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket is fixed to pager-private and must remain private.
# RU/EN OTP templates: supabase/templates; copy to hosted Auth settings separately.
# Email confirmations on, OTP length 6, expiry 600s; configure real SMTP for delivery.
# Configure production PAGER_APP_URL as the canonical HTTPS origin.
# Provider setup and webhook registration: docs/INTEGRATIONS.md.
# Exactly 32 random bytes encoded in base64. Server only; required to encrypt credentials.
PAGER_INTEGRATION_KEY=

# Stripe Connect direct charges. Sandbox remains separate from local demo.
STRIPE_SECRET_KEY=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_WEBHOOK_SECRET=
PAGER_STRIPE_LIVE=false

# Approved Cal OAuth client; creator API key fallback is configured inside PAGER.
CAL_OAUTH_CLIENT_ID=
CAL_OAUTH_CLIENT_SECRET=

# Email notifications remain disabled until provider setup/delivery is verified.
PAGER_NOTIFICATIONS_ENABLED=false
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
RESEND_API_KEY=
RESEND_FROM=PAGER <bookings@your-verified-domain.example>

# Optional Telegram, paired by each verified recipient. Independent of email.
PAGER_TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# 32-256 URL-safe characters. Set the same value in Telegram setWebhook.secret_token.
TELEGRAM_WEBHOOK_SECRET=
